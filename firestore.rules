rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        getUserRole() == 'admin'
      );
    }

    function isTeacherOrTutor() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' || 
        request.auth.token.role == 'tutor' ||
        getUserRole() == 'teacher' || 
        getUserRole() == 'tutor' ||
        isAdmin()
      );
    }

    // Helper to check document author/owner
    function resourceOwner() {
       return request.auth.uid == resource.data.auteurId;
    }

    // ── USERS & SUBCOLLECTIONS ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow sign-up (creation) for any auth user; updates/deletions only by owner or admin
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Allow users to read/write all their subcollections (sessions, personalDocs, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ── CHATS COLLECTION (AI Session History) ──────────────────────────────────
    match /chats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── RESOURCES COLLECTION (Academic Resources) ──────────────────────────────
    match /resources/{resourceId} {
      allow read: if true; // Publicly accessible to students/tutors
      allow write: if isTeacherOrTutor();
    }

    // ── CONTRIBUTIONS COLLECTION ──────────────────────────────────────────────
    match /contributions/{contributionId} {
      allow read: if isAuthenticated() && (resourceOwner() || isAdmin());
      allow write: if isAuthenticated();
    }

    // ── ADMIN SETTINGS ────────────────────────────────────────────────────────
    match /adminSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── SUBMISSIONS COLLECTION ────────────────────────────────────────────────
    match /submissions/{submissionId} {
      allow read, write: if isAuthenticated();
    }

    // ── TUTOR APPLICATIONS ────────────────────────────────────────────────────
    match /tutorApplications/{applicationId} {
      allow read, write: if isAuthenticated();
    }

    // ── SUPPORT TICKETS / CHATS ───────────────────────────────────────────────
    match /support/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    match /support_chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == chatId || isAdmin());
    }

    // ── COMMUNITY / FORUMS COLLECTION ──────────────────────────────────────────
    match /forums/{forumId} {
      allow read, write: if isAuthenticated();
      match /{allSubcollections=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /forum_memberships/{membershipId} {
      allow read, write: if isAuthenticated();
    }

    // ── COMMUNITY POSTS ───────────────────────────────────────────────────────
    match /community/{postId} {
      allow read, write: if isAuthenticated();
    }
  }
}
